# Normalize line endings so a Windows checkout never corrupts files that are
# executed inside the Linux container. Without this, core.autocrlf=true (the
# Windows default) rewrites shell scripts to CRLF on checkout; the container's
# kernel then reads the shebang as `#!/bin/sh\r`, fails to exec the interpreter,
# and the ENTRYPOINT dies with exit code 255.
# Origin of this fix: hexcaliper-scrivener commit afe41f6.

# Default: let git decide text vs binary, but always check out text as LF.
* text=auto eol=lf

# Files run by /bin/sh inside the container — MUST stay LF on every platform.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf

# Windows host scripts — the mirror image of the rule above.  The sidecar wrappers
# are launched by Task Scheduler on the Windows host, never inside the container,
# and cmd.exe's parser is only reliable on CRLF: an LF-only batch file can
# misparse labels and multi-line for/if blocks.  The blanket `eol=lf` default
# would otherwise force LF on these and reintroduce, in reverse, exactly the
# platform breakage the LF policy exists to prevent.
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Other text that should stay LF for the Linux image / tooling.
*.py            text eol=lf
*.toml          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Binary assets — never touch these.  One pattern per line: git reads only the
# first token on a line as the pattern and every token after it as an attribute
# name, so a combined line like `*.png *.jpg binary` is rejected whole and
# silently protects nothing.  Verify with `git check-attr binary -- <files>`,
# not by reading this file.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.pdf           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.so            binary
*.so.*          binary
